# Telegram Bot Configuration
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID to receive instant visitor alerts
# Get your Chat ID by messaging @userinfobot or using the /myid command in your bot
TELEGRAM_CHAT_ID=

# Optional: Webhook Secret Token for verifying updates from Telegram
TELEGRAM_WEBHOOK_SECRET=

# Public Portfolio URL (for webhooks & links)
PORTFOLIO_URL=https://abhijeet-kr.vercel.app
NEXT_PUBLIC_SITE_URL=https://abhijeet-kr.vercel.app

# Environment
NODE_ENV=production
